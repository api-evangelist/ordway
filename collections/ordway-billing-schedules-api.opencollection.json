        {
          "info": {
            "name": "Retrieve a billing schedule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ordwaylabs.com/api/v1/billing_schedules/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource identifier"
              }
            ]
          },
          "docs": "Retrieve a billing schedule"
        }
      ]
    }
  ],
  "bundled": true
}