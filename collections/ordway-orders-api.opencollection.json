            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ordwaylabs.com/api/v1/orders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-based)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of records per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of fields to sort by (prefix with - for descending)"
              },
              {
                "name": "updated_date>",
                "value": "",
                "type": "query",
                "description": "Filter orders updated after this date-time (ISO 8601)"
              }
            ]
          },
          "docs": "List orders"
        },
        {
          "info": {
            "name": "Create an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
