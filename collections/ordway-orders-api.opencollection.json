            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an order"
        },
        {
          "info": {
            "name": "Retrieve an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ordwaylabs.com/api/v1/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Resource identifier"
              }
            ]
          },
          "docs": "Retrieve an order"
        }
      ]
    }
  ],
  "bundled": true
}